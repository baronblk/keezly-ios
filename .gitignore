# ── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
._*

# ── Xcode ──────────────────────────────────────────────────────────────────
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcresult
*.xcarchive

# Xcode project is generated by XcodeGen but COMMITTED (see docs/DECISIONS.md).
# Only the workspace-local user state is ignored.
Keezly.xcodeproj/project.xcworkspace/xcuserdata/
Keezly.xcodeproj/xcuserdata/

# ── Swift Package Manager ──────────────────────────────────────────────────
.build/
.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/
# Package.resolved IS committed for reproducible CI builds.

# ── Ruby / Bundler / Fastlane ──────────────────────────────────────────────
vendor/bundle/
.bundle/
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md.bak
fastlane/screenshots/**/*.html
fastlane/screenshots/screenshots.html

# ── Generated artifacts (never versioned) ──────────────────────────────────
artifacts/
!artifacts/.gitkeep

# ── SECRETS — never commit ─────────────────────────────────────────────────
*.p8
*.p12
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
.env
.env.*
!.env.example
AuthKey_*.json
AuthKey_*
appstore_connect_api_key.json
fastlane/.env
fastlane/*.env
fastlane/Matchfile
secrets/
Credentials/
