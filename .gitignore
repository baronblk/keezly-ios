# ── macOS ──────────────────────────────────────────────────────────────────
.DS_Store
._*

# ── Xcode ──────────────────────────────────────────────────────────────────
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcresult
*.xcarchive

# Xcode project is generated by XcodeGen but COMMITTED (see docs/DECISIONS.md).
# Only the workspace-local user state is ignored.
Keezly.xcodeproj/project.xcworkspace/xcuserdata/
Keezly.xcodeproj/xcuserdata/

# ── Swift Package Manager ──────────────────────────────────────────────────
.build/
.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/
# Package.resolved IS committed for reproducible CI builds.

# ── Ruby / Bundler / Fastlane ──────────────────────────────────────────────
vendor/bundle/
.bundle/
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md.bak
fastlane/screenshots/**/*.html
fastlane/screenshots/screenshots.html

# ── Generated artifacts (never versioned) ──────────────────────────────────
artifacts/
!artifacts/.gitkeep

# ── SECRETS — never commit ─────────────────────────────────────────────────
*.p8
*.p12
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
.env
.env.*
!.env.example
AuthKey_*.json
AuthKey_*
appstore_connect_api_key.json
fastlane/.env
fastlane/*.env
fastlane/Matchfile
secrets/
Credentials/

# Local device role mapping — device names and UDIDs are local development
# information and never belong in the repository (§158).
.keezly-devices.env

# Developer- and account-specific signing configuration (§106, MAN-03).
Config/Local.xcconfig

# Generated by ci_pre_xcodebuild.sh from CI_BUILD_NUMBER (§105).
Config/BuildNumber.xcconfig

# Built website output and its zip. The sources under website/ are committed;
# the build is reproducible with `python3 website/build.py`.
website/dist/
website/website-keezly-*.zip
