# frozen_string_literal: true

# Keezly build tooling.
#
# fastlane is always invoked through Bundler so its version is pinned by
# Gemfile.lock and therefore reproducible on every machine and in CI:
#
#   bundle exec fastlane <lane>
#
# See FASTLANE.md for the available lanes.

source "https://rubygems.org"

gem "fastlane", "~> 2.234"
