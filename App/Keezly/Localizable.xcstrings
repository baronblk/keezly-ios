        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat doet deze kaart?"
          }
        }
      }
    },
    "a11y.consequence.capture %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knocks %@ out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat %@ eruit."
          }
        }
      }
    },
    "a11y.consequence.finishes": {
      "extractionState": "manual",
