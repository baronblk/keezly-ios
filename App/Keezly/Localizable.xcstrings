          }
        }
      }
    },
    "rules.blocking.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A protected start square always blocks. Whether your own pawns elsewhere on the track do the same is a decision for the table."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein geschütztes Startfeld sperrt immer. Ob auch die eigenen Figuren anderswo auf der Bahn sperren, entscheidet der Tisch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een beschermd startvakje blokkeert altijd. Of je eigen pionnen elders op de baan dat ook doen, bepaalt de tafel."
          }
        }
      }
    },
    "rules.blocking.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What blocks the track"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Bahn sperrt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat de baan blokkeert"
          }
        }
      }
    },
    "rules.capture.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land exactly on an unprotected pawn and it goes back to its owner's start, however far it had come."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer genau auf einer ungeschützten Figur landet, schickt sie zurück in ihren Start — ganz gleich, wie weit sie schon gekommen war."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom je precies op een onbeschermde pion uit, dan gaat die terug naar zijn eigen start, hoe ver hij ook al was."
          }
        }
      }
    },
    "rules.capture.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knocking a pawn out"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlagen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaan"
          }
        }
      }
    },
    "rules.chapter.cards": {
      "extractionState": "manual",
      "localizations": {
