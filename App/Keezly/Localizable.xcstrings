          }
        }
      }
    },
    "rules.chapter.special": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What each card does"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was die Karten können"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat de kaarten doen"
          }
        }
      }
    },
    "rules.deal.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards come in three rounds: five each, then four, then four. That is thirteen apiece and uses the deck up exactly. When every hand is spent the cards are gathered and shuffled, the deal passes one seat clockwise, and a new cycle begins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegeben wird in drei Runden: erst fünf, dann vier, dann vier. Das sind dreizehn pro Person und verbraucht das Blatt genau. Sind alle Hände gespielt, werden die Karten eingesammelt und gemischt, das Geben wandert einen Platz im Uhrzeigersinn weiter, und ein neuer Durchgang beginnt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt in drie rondes gedeeld: eerst vijf, dan vier, dan nog eens vier. Dat zijn er dertien per speler en daarmee is het spel precies op. Zijn alle handen gespeeld, dan worden de kaarten verzameld en geschud, schuift het delen één plaats met de klok mee op en begint een nieuwe ronde."
          }
        }
      }
    },
    "rules.deal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geben"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het delen"
          }
        }
      }
    },
    "rules.deck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One full run of ranks per player — ace to king, thirteen cards — so two players share twenty-six and six players seventy-eight. The suits are printed for looks; no rule depends on them, and there are no jokers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Person ein vollständiger Satz Werte — Ass bis König, dreizehn Karten. Zu zweit sind das sechsundzwanzig, zu sechst achtundsiebzig. Die Farben sind reine Optik; keine Regel hängt an ihnen, und Joker gibt es nicht."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Per speler één volledige reeks waarden — aas tot en met heer, dertien kaarten. Met z'n tweeën zijn dat er zesentwintig, met z'n zessen achtenzeventig. De kleuren zijn er voor het oog; geen enkele regel hangt ervan af, en jokers zitten er niet bij."
          }
        }
      }
    },
    "rules.deck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deck"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Blatt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het spel kaarten"
          }
        }
      }
    },
    "rules.entering.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pawns wait in your start until an ace or a king brings one out onto your start square. Nothing else opens the gate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Figuren warten im Start, bis ein Ass oder ein König eine davon auf dein Startfeld stellt. Etwas anderes öffnet das Tor nicht."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pionnen wachten in de start tot een aas of een heer er één op je startvakje zet. Iets anders krijgt ze er niet uit."
          }
        }
      }
    },
    "rules.entering.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coming out"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Herauskommen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar buiten komen"
          }
        }
      }
    },
    "rules.fold.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when not one card in your hand can be played at all do you throw the whole hand in. You then sit out the rest of this deal round and come back with the next one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst wenn keine einzige Karte spielbar ist, wirfst du die ganze Hand ab. Du setzt dann für den Rest dieser Runde aus und bist beim nächsten Geben wieder dabei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas als geen enkele kaart te spelen is, gooi je je hele hand weg. Je slaat de rest van deze deelronde over en doet bij de volgende weer mee."
          }
        }
      }
    },
    "rules.fold.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dead hand"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine tote Hand"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een dode hand"
          }
        }
      }
    },
    "rules.forcedMove.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If any card in your hand gives you a legal move, you must play one — even a move you would rather not make. Holding a good card back is not allowed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn irgendeine Karte auf deiner Hand einen legalen Zug erlaubt, musst du ziehen — auch einen Zug, den du lieber vermeiden würdest. Eine gute Karte zurückzuhalten ist nicht erlaubt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan één van je kaarten een geldige zet opleveren, dan moet je zetten — ook een zet die je liever niet zou doen. Een goede kaart achterhouden mag niet."
          }
        }
      }
    },
    "rules.forcedMove.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have to move"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugzwang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet zetten"
          }
        }
      }
    },
    "rules.four.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactly four squares backward. Never into a home lane and never out of one, and it cannot cross a protected start square. Played at the right moment it is the fastest route there is: step back past your own start and your home entry is right in front of you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau vier Felder zurück. Nie in ein Ziel hinein und nie aus einem heraus, und ein geschütztes Startfeld kann sie nicht überqueren. Im richtigen Moment ist sie die schnellste Abkürzung überhaupt: rückwärts an deinem Start vorbei, und die Zieleinfahrt liegt direkt vor dir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Precies vier vakjes achteruit. Nooit een huis in en nooit een huis uit, en langs een beschermd startvakje komt hij niet. Op het juiste moment is het de snelste route die er is: achteruit langs je eigen start en je ingang ligt pal voor je."
          }
        }
      }
    },
    "rules.four.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier"
          }
        }
      }
    },
    "rules.friendlyCapture.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Landing on a pawn of your own colour, or your partner's, is something tables handle differently. Because you must move when you can, the answer decides whether you can be forced to knock out your own partner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ob man auf einer eigenen Figur oder der der Partnerin landen darf, wird am Tisch unterschiedlich gehandhabt. Weil Zugzwang herrscht, entscheidet die Antwort, ob du gezwungen sein kannst, die eigene Partnerin zu schlagen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of je op een pion van je eigen kleur of die van je maat mag landen, verschilt per tafel. Omdat je moet zetten als het kan, bepaalt het antwoord of je gedwongen kunt worden je eigen maat eruit te slaan."
          }
        }
      }
    },
    "rules.friendlyCapture.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own side"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eigenen Figuren"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je eigen kant"
          }
        }
      }
    },
    "rules.goal.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring all four of your pawns out of your start, right around the board, and into your own home lane. The first to manage it wins — and playing in partnership, a side wins only once both partners have finished."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring alle vier Figuren aus deinem Start einmal rund ums Brett in dein eigenes Ziel. Wer das zuerst schafft, gewinnt — im Paarspiel erst dann, wenn beide Partner fertig sind."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Breng al je vier pionnen vanuit je start helemaal rond het bord naar je eigen huis. Wie dat het eerst voor elkaar krijgt, wint — bij koppelspel pas als allebei de maten binnen zijn."
          }
        }
      }
    },
    "rules.goal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you are trying to do"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Worum es geht"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar het om gaat"
          }
        }
      }
    },
    "rules.homeEntry.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your home lane needs an exact count. What happens when the number does not fit — whether the pawn simply cannot move or may carry on for another lap — is a decision for the table."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ins Ziel kommt man nur mit genauer Zahl. Was passiert, wenn die Zahl nicht passt — ob die Figur einfach stehen bleibt oder noch eine Runde weiterlaufen darf — entscheidet der Tisch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je huis in kan alleen met een precies passend aantal. Wat er gebeurt als het niet uitkomt — blijft de pion staan of mag hij nog een ronde door — bepaalt de tafel."
          }
        }
      }
    },
    "rules.homeEntry.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting in"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfahren"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar binnen"
          }
        }
      }
    },
    "rules.homeOrdering.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pawn may never jump over one that is already home. Beyond that, whether it may take any square it can reach exactly or has to fill the lane from the back is a choice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über eine Figur, die schon im Ziel steht, wird nie gesprungen. Darüber hinaus ist es Absprache, ob jedes genau erreichbare Zielfeld erlaubt ist oder von hinten aufgefüllt werden muss."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Over een pion die al binnen is, spring je nooit heen. Verder is het een afspraak of elk precies bereikbaar vakje mag, of dat je van achteren naar voren moet vullen."
          }
        }
      }
    },
    "rules.homeOrdering.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which home square"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welches Zielfeld"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welk huisvakje"
          }
        }
      }
    },
    "rules.homeSafety.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pawn in a home lane is out of everybody's way: nothing can knock it out and no jack can swap it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Figur im Ziel ist aus dem Spiel heraus: Nichts kann sie schlagen, kein Bube sie tauschen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een pion in het huis staat buiten schot: niets slaat hem eruit en geen boer ruilt hem weg."
          }
        }
      }
    },
    "rules.homeSafety.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe at home"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Ziel sicher"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Binnen is veilig"
          }
        }
      }
    },
    "rules.houseRuled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This table changes at least one rule from the traditional game."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An diesem Tisch weicht mindestens eine Regel vom überlieferten Spiel ab."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aan deze tafel wijkt minstens één regel af van het traditionele spel."
          }
        }
      }
    },
    "rules.jack.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap one of your pawns on the track with another player's pawn on the track — a partner's counts. Pawns still waiting, pawns already home and pawns protected on their own start square are all out of reach."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tausche eine deiner Figuren auf der Bahn gegen die Figur einer anderen Person auf der Bahn — die der Partnerin zählt mit. Figuren im Start, Figuren im Ziel und geschützte Figuren auf ihrem eigenen Startfeld sind tabu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruil een van jouw pionnen op de baan met de pion van een andere speler op de baan — die van je maat telt mee. Pionnen die nog in de start staan, pionnen die al binnen zijn en beschermde pionnen op hun eigen startvakje blijven buiten schot."
          }
        }
      }
    },
    "rules.jack.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bube"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boer"
          }
        }
      }
    },
    "rules.jackOwnStart.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That a protected pawn cannot be taken is agreed everywhere. Whether such a pawn may give up its protection voluntarily and do the swapping itself is not."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dass eine geschützte Figur nicht genommen werden kann, ist überall gleich. Ob sie freiwillig auf ihren Schutz verzichten und selbst tauschen darf, ist es nicht."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat een beschermde pion niet gepakt kan worden, is overal hetzelfde. Of zo'n pion zijn bescherming vrijwillig mag opgeven en zélf mag ruilen, niet."
          }
        }
      }
    },
    "rules.jackOwnStart.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The jack and your own start"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bube und eigenes Startfeld"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De boer en je eigen start"
          }
        }
      }
    },
    "rules.king.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The king brings a pawn out of your start. Whether it can also be spent as thirteen squares forward is the best-known house rule in the game."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der König holt eine Figur aus dem Start. Ob er außerdem als dreizehn Felder gespielt werden darf, ist die bekannteste Hausregel des Spiels."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De heer haalt een pion uit je start. Of je hem daarnaast als dertien vakjes mag spelen, is de bekendste huisregel van het spel."
          }
        }
      }
    },
    "rules.king.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "King"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "König"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heer"
          }
        }
      }
    },
    "rules.leaving.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Giving up in partnership play forfeits the match for your side. In a free-for-all your pawns come off the board and the others play on; whoever is left at the end wins. This one is Keezly's own policy rather than a traditional rule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer im Paarspiel aufgibt, verliert die Partie für das ganze Paar. Spielt jede für sich, verschwinden deine Figuren vom Brett und die übrigen spielen weiter; wer übrig bleibt, gewinnt. Das ist eine Festlegung von Keezly, keine überlieferte Regel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie bij koppelspel opgeeft, verliest de partij voor het hele koppel. Speelt iedereen voor zichzelf, dan gaan je pionnen van het bord en spelen de anderen door; wie overblijft, wint. Dit is een keuze van Keezly, geen overgeleverde regel."
          }
        }
      }
    },
    "rules.leaving.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving a match"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Partie verlassen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een partij verlaten"
          }
        }
      }
    },
    "rules.moving.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most cards simply move one pawn that many squares forward: two to ten as printed, a queen twelve. A pawn travels almost the whole way round and then turns off at its own home entry, the square just before its start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Karten ziehen eine Figur einfach so viele Felder vor, wie aufgedruckt sind: zwei bis zehn, die Dame zwölf. Eine Figur läuft fast einmal ganz herum und biegt dann an ihrer Zieleinfahrt ab — dem Feld direkt vor ihrem eigenen Start."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meeste kaarten zetten een pion gewoon zoveel vakjes vooruit als erop staat: twee tot en met tien, de vrouw twaalf. Een pion loopt bijna helemaal rond en slaat dan af bij zijn eigen ingang — het vakje net vóór zijn start."
          }
        }
      }
    },
    "rules.moving.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving forward"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorwärts ziehen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vooruit zetten"
          }
        }
      }
    },
