    "rules.turnOrder.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The player to the dealer's left opens, and the turn passes clockwise. On your turn you play exactly one card and make the move it allows."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links von der Geberin wird eröffnet, danach geht es im Uhrzeigersinn weiter. Wer dran ist, spielt genau eine Karte und führt den Zug aus, den sie erlaubt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Links van de deler wordt geopend, daarna gaat het met de klok mee. Wie aan zet is, speelt precies één kaart en doet de zet die daarbij hoort."
          }
        }
      }
    },
    "rules.turnOrder.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whose turn it is"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer dran ist"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie aan zet is"
          }
        }
      }
    },
    "rules.variation.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tables disagree about this one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier sind sich die Tische nicht einig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hierover verschillen de tafels van mening."
          }
        }
      }
    },
    "rules.winning.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All four of your pawns home. In partnership play the side wins only when every player on it has done it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vier Figuren im Ziel. Im Paarspiel gewinnt das Paar erst, wenn beide so weit sind."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al je vier pionnen binnen. Bij koppelspel wint het koppel pas als allebei zover zijn."
          }
        }
      }
    },
    "rules.winning.title": {
