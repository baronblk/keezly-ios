    "action.fold.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No card can be played, so the whole hand is discarded"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Karte ist spielbar, deshalb wird die ganze Hand abgelegt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen kaart is speelbaar, dus de hele hand gaat weg"
          }
        }
      }
    },
