{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "card.unplayable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No legal move"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein legaler Zug"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen geldige zet"
          }
        }
      }
    },
    "card.ace.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ace. Bring a pawn out, or move one square"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ass. Figur herausbringen oder ein Feld vor"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aas. Een pion eruit, of één vakje vooruit"
          }
        }
      }
    },
    "card.king.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "King. Bring a pawn out"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "König. Figur herausbringen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heer. Een pion eruit"
          }
        }
      }
    },
    "card.queen.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queen. Twelve squares forward"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dame. Zwölf Felder vor"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrouw. Twaalf vakjes vooruit"
          }
        }
      }
    },
    "card.jack.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack. Swap two pawns"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bube. Zwei Figuren tauschen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boer. Twee pionnen ruilen"
          }
        }
      }
    },
    "card.four.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four. Four squares backward"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier. Vier Felder zurück"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier. Vier vakjes achteruit"
          }
        }
      }
    },
    "card.seven.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven. Seven steps, split across one or two pawns"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieben. Sieben Schritte, auf eine oder zwei Figuren aufteilbar"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeven. Zeven stappen, over één of twee pionnen"
          }
        }
      }
    },
    "card.number.spoken %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. %lld squares forward"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. %lld Felder vor"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. %lld vakjes vooruit"
          }
        }
      }
    },
    "pile.draw %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw pile, %lld cards"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachziehstapel, %lld Karten"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trekstapel, %lld kaarten"
          }
        }
      }
    },
    "pile.discard %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard pile, top card %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ablagestapel, oberste Karte %@"
