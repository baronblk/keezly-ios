      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose or invite a player in Game Center."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle in Game Center jemanden aus oder lade jemanden ein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of nodig iemand uit in Game Center."
          }
        }
      }
    },
    "online.state.openingMatchmaker": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening Game Center …"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center wird geöffnet …"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center wordt geopend …"
          }
        }
      }
    },
    "online.state.waitingForPlayers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for players to join."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird noch auf Mitspieler gewartet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt nog op medespelers gewacht."
          }
        }
      }
    },
    "online.state.waitingForPlayers.detail %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld seats taken. The match is in your list and starts by itself once it is full."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Plätzen besetzt. Die Partie steht in deiner Liste und beginnt von selbst, sobald sie voll ist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld van %2$lld plaatsen bezet. De partij staat in je lijst en begint vanzelf zodra die vol is."
          }
        }
      }
    },
    "online.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn by turn, through Game Center. Take your turn when you like — the others get theirs when they open the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zug um Zug über Game Center. Spiel, wann es dir passt — die anderen sind dran, sobald sie die App öffnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beurt om beurt via Game Center. Speel wanneer het jou uitkomt — de anderen zijn aan de beurt zodra ze de app openen."
          }
        }
      }
    },
