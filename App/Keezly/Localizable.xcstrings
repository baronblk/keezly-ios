    "lesson.capture.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Land exactly on somebody else's pawn and it goes straight back to its own corner, however far it had come. Nothing about this is polite, and you cannot avoid it either: if you have a legal move, you have to play one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Landest du genau auf der Figur einer anderen Person, geht sie sofort zurück in ihre Ecke — ganz gleich, wie weit sie schon war. Das ist nicht unhöflich, sondern das Spiel: Wer ziehen kann, muss ziehen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom je precies op de pion van een ander uit, dan gaat die meteen terug naar zijn eigen hoek, hoe ver hij ook al was. Dat hoort erbij, en je kunt er niet omheen: kun je zetten, dan moet je zetten."
          }
        }
      }
    },
    "lesson.capture.task": {
      "extractionState": "manual",
      "localizations": {
        "en": {
