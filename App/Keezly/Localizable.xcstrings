          }
        }
      }
    },
    "rules.chapter.moving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen"
          }
        },
        "nl": {
          "stringUnit": {
