          }
        }
      }
    },
    "lesson.unavailable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The position it needs was not reached. That is a fault in the lesson, not in your play — skip it and carry on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die benötigte Stellung wurde nicht erreicht. Das ist ein Fehler der Lektion, nicht deines Spiels — überspring sie einfach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De benodigde stelling werd niet bereikt. Dat ligt aan de les, niet aan jouw spel — sla hem over en ga door."
          }
        }
      }
    },
