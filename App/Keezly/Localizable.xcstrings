{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "a11y.actions.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists every move you can play now, so you do not have to hit a square on the board."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet jeden Zug auf, den du jetzt spielen kannst — ohne ein Feld auf dem Brett treffen zu müssen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont elke zet die je nu kunt spelen, zonder een vakje op het bord te hoeven raken."
          }
        }
      }
    },
    "a11y.actions.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No legal move. You must throw in your hand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein legaler Zug. Du musst die Hand abwerfen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen geldige zet. Je moet je hand weggooien."
          }
        }
      }
    },
    "a11y.actions.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show legal moves"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mögliche Züge anzeigen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogelijke zetten tonen"
          }
        }
      }
    },
    "a11y.actions.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legal moves"
