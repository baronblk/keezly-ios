    "settings.haptics.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small knock when a piece goes down, is knocked out or comes home. Quiet by design — a board game is played for an hour at a time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleiner Impuls, wenn eine Figur gesetzt, geschlagen oder ins Ziel gebracht wird. Bewusst zurückhaltend — ein Brettspiel dauert eine Stunde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een klein stootje als een pion wordt neergezet, geslagen of binnengebracht. Bewust ingetogen — een bordspel duurt een uur."
          }
        }
      }
    },
    "settings.sound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
