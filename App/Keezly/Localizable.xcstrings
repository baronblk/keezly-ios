    "card.ace.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ace. Bring a pawn out, or move one square"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ass. Figur herausbringen oder ein Feld vor"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aas. Een pion eruit, of één vakje vooruit"
          }
        }
      }
    },
    "card.four.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four. Four squares backward"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier. Vier Felder zurück"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier. Vier vakjes achteruit"
          }
        }
      }
    },
    "card.jack.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jack. Swap two pawns"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bube. Zwei Figuren tauschen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boer. Twee pionnen ruilen"
          }
        }
      }
    },
    "card.king.spoken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "King. Bring a pawn out"
