    "rules.ace.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either bring a pawn out onto your start square, or move a pawn one square forward. Your choice, every time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entweder eine Figur auf dein Startfeld holen oder eine Figur ein Feld vorziehen. Jedes Mal deine Wahl."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Óf een pion op je startvakje zetten, óf een pion één vakje vooruit. Elke keer opnieuw jouw keuze."
          }
        }
      }
    },
