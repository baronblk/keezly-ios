      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the other players. You can close Keezly — you will get your turn back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die anderen sind am Zug. Du kannst Keezly schließen — dein Zug kommt zurück."
