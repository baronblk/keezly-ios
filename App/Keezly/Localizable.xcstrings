            "state": "translated",
            "value": "Ton"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geluid"
          }
        }
      }
    },
    "settings.sound.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same moments, heard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieselben Momente, hörbar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezelfde momenten, hoorbaar."
          }
        }
      }
    },
    "settings.sound.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keezly has no sounds yet. It will only ever ship audio it owns outright, and a set of stand-in noises heard on every move would be worse than silence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keezly hat noch keine Töne. Es wird nur Audio ausgeliefert, das uns wirklich gehört — und Platzhaltergeräusche, die man bei jedem Zug hört, wären schlechter als Stille."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Keezly heeft nog geen geluiden. Er wordt alleen audio meegeleverd die echt van ons is; tijdelijke geluidjes die je bij elke zet hoort zouden erger zijn dan stilte."
          }
        }
      }
    },
