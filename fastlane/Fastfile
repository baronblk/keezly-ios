# frozen_string_literal: true

# Keezly lanes. Always invoked through Bundler:
#
#   bundle exec fastlane <lane>
#
# Documented in FASTLANE.md. Two rules govern everything here:
#
#   1. A lane never reports success for something it did not run. A missing
#      device produces BLOCKED, not PASSED (§177).
#   2. Lanes do not duplicate Xcode Cloud. There is no archive lane and no
#      TestFlight upload lane (§85, DEC-008).

# fastlane reads and re-encodes its own output, and it cannot do that when the
# shell has no UTF-8 locale: `ui_tests` crashed with
#
#   scan/error_handler.rb: 'Regexp#===': invalid byte sequence in US-ASCII
#   shell.rb: 'String#encode': "\xE2\x9A" on UTF-16
#
# which reads like a test failure and is not — it is fastlane failing to print.
# A build machine with an empty LANG is normal, so the lanes set one rather
# than depending on whoever starts them. It affects fastlane's own output only;
# nothing in the app or the tests reads it.
ENV["LANG"] ||= "en_US.UTF-8"
ENV["LC_ALL"] ||= "en_US.UTF-8"
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = nil

default_platform(:ios)

REPO_ROOT   = File.expand_path("..", __dir__)
PROJECT     = "Keezly.xcodeproj"
SCHEME      = "Keezly"
CORE_PATH   = File.join(REPO_ROOT, "Packages", "KeezlyCore")
ARTIFACTS   = File.join(REPO_ROOT, "artifacts")

# Simulator destinations used by the fast local matrix. Names are resolved
# against whatever is installed rather than pinned to an OS version.
SIM_IPHONE = "iPhone 17"
SIM_IPAD   = "iPad Pro 13-inch (M5)"

# ── helpers ────────────────────────────────────────────────────────────────

# Resolves a physical device role via scripts/devices.sh.
# Returns an xcodebuild destination string, or nil when the role is unfilled.
def physical_destination(role)
  output = `#{File.join(REPO_ROOT, "scripts", "devices.sh")} destination #{role} 2>/dev/null`.strip
  $?.success? && !output.empty? ? output : nil
end

def report_blocked(gate, role)
  UI.important("#{gate}: BLOCKED — no physical device fills the role #{role}")
  UI.important("Run scripts/devices.sh list for what to do about it.")
end

# Loads App Store Connect credentials from a file kept outside the repository.
# Returns false when no credentials are configured, so lanes can report that
# honestly rather than failing with an opaque authentication error (§107).
def load_asc_env
  path = ENV["KEEZLY_ASC_ENV"]
  return false if path.nil? || path.empty? || !File.exist?(path)

  File.readlines(path).each do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    ENV[key] = value if key && value
  end
  %w[KEEZLY_ASC_ISSUER_ID KEEZLY_ASC_KEY_ID KEEZLY_ASC_KEY_PATH].all? { |k| ENV[k].to_s != "" }
end

# Configures the App Store Connect API key for actions that need it.
def configure_asc_api_key
  unless load_asc_env
    UI.important("App Store Connect credentials not configured — see .env.example")
    return false
  end
  app_store_connect_api_key(
    key_id: ENV.fetch("KEEZLY_ASC_KEY_ID"),
    issuer_id: ENV.fetch("KEEZLY_ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("KEEZLY_ASC_KEY_PATH"),
    in_house: false
  )
  true
end

def run_core_tests
  UI.header("KeezlyCore — rules engine")
  Dir.chdir(CORE_PATH) { sh("swift test") }
end

# ── lanes ──────────────────────────────────────────────────────────────────

platform :ios do
  desc "Full unit and integration tests: rules engine plus app-level tests on a simulator"
  lane :tests do
    run_core_tests
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [SIM_IPHONE],
      only_testing: ["KeezlyTests"],
      result_bundle: true,
      output_directory: File.join(ARTIFACTS, "test-results", "unit"),
      xcodebuild_formatter: "xcbeautify --quiet"
    )
  end

  desc "XCUITests on an iPhone and an iPad simulator"
  lane :ui_tests do
    # `DesignReviewScreenshots` is deliberately excluded. It is a *capture*
    # suite, not a correctness suite: it drives fourteen launches per device,
    # rotates for most of them, sleeps a second and a half each time and does
    # heavy image work — and measured, running it ahead of the others makes a
    # later test fail that passes every other way it has been run (ISS-020).
    # Without it these four classes are green; with it they are not.
    #
    # Nothing is lost by moving it. What it asserts about a capture —
    # orientation and size — is checked far more strictly on the files
    # themselves by `scripts/screenshots-verify.py`, which is where an
    # assertion about a capture belongs, because an assertion in the test
    # proves nothing about the file that ships. The `screenshots` lane runs it.
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [SIM_IPHONE, SIM_IPAD],
      only_testing: %w[
        KeezlyUITests/LaunchTests
        KeezlyUITests/MenuFlowTests
        KeezlyUITests/PassAndPlayTests
        KeezlyUITests/PlayFlowTests
      ],
      result_bundle: true,
      output_directory: File.join(ARTIFACTS, "test-results", "ui"),
      xcodebuild_formatter: "xcbeautify --quiet"
    )
  end

  desc "Verify App Store Connect credentials and whether the app record exists"
  lane :asc_check do
    unless configure_asc_api_key
      UI.user_error!("App Store Connect API key not configured")
    end

    UI.success("Credentials load: OK (key #{ENV.fetch('KEEZLY_ASC_KEY_ID')})")

    # Spaceship confirms the credentials actually authenticate, and tells us
    # whether MAN-02 (the app record) is still outstanding.
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("KEEZLY_ASC_KEY_ID"),
      issuer_id: ENV.fetch("KEEZLY_ASC_ISSUER_ID"),
      filepath: ENV.fetch("KEEZLY_ASC_KEY_PATH")
    )
    app = Spaceship::ConnectAPI::App.find("de.gcng.keezly")
    if app
      UI.success("App record de.gcng.keezly exists (#{app.name}, id #{app.id})")
    else
      UI.important("App record de.gcng.keezly does NOT exist yet — MAN-02 is still OPEN")
    end
  end

  desc "Build, install and launch on whichever physical device is available"
  lane :device_smoke do
    destination = physical_destination("PRIMARY_IPHONE") || physical_destination("PRIMARY_IPAD")
    if destination.nil?
      report_blocked("Device smoke", "PRIMARY_IPHONE or PRIMARY_IPAD")
      UI.user_error!("DEVICE NOT AVAILABLE")
    end
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      destination: destination,
      only_testing: ["KeezlyUITests/LaunchTests/testAppLaunches"],
      result_bundle: true,
      output_directory: File.join(ARTIFACTS, "test-results", "device-smoke"),
      xcodebuild_formatter: "xcbeautify --quiet"
    )
  end

  desc "The physical iPhone gate"
  lane :device_iphone do
    destination = physical_destination("PRIMARY_IPHONE")
    if destination.nil?
      report_blocked("Physical iPhone gate", "PRIMARY_IPHONE")
      UI.user_error!("DEVICE NOT AVAILABLE")
    end
    run_tests(
      project: PROJECT, scheme: SCHEME, destination: destination,
      result_bundle: true,
      output_directory: File.join(ARTIFACTS, "test-results", "device-iphone"),
      xcodebuild_formatter: "xcbeautify --quiet"
    )
  end

  desc "The physical iPad gate"
  lane :device_ipad do
    destination = physical_destination("PRIMARY_IPAD")
    if destination.nil?
      report_blocked("Physical iPad gate", "PRIMARY_IPAD")
      UI.user_error!("DEVICE NOT AVAILABLE")
    end
    run_tests(
      project: PROJECT, scheme: SCHEME, destination: destination,
      result_bundle: true,
      output_directory: File.join(ARTIFACTS, "test-results", "device-ipad"),
      xcodebuild_formatter: "xcbeautify --quiet"
    )
  end

  desc "Both physical device gates"
  lane :device_gate do
    device_iphone
    device_ipad
  end

  desc "The App Store screenshot set: every locale, both devices, written to disk"
  lane :screenshots do
    # Delegated to the script rather than reimplemented here, because the
    # capture set is also run on its own during design work and two copies of
    # the locale matrix would drift.
    Dir.chdir(REPO_ROOT) do
      sh("./scripts/screenshots.sh #{File.join(ARTIFACTS, "screenshots")}")
    end
    UI.success("screenshots written to artifacts/screenshots and verified")
  end

  desc "Check an existing screenshot set without re-capturing it"
  lane :screenshots_verify do
    directory = File.join(ARTIFACTS, "screenshots")
    UI.user_error!("No screenshot set at #{directory} — run the screenshots lane first") \
      unless Dir.exist?(directory)

    Dir.chdir(REPO_ROOT) do
      sh("python3 scripts/screenshots-verify.py #{directory}")
    end
    UI.success("screenshot set passed the mechanical gate")
    UI.important("Whether they sell the app is a judgement no lane makes.")
  end

  desc "Static checks: SwiftLint and SwiftFormat"
  lane :lint do
    Dir.chdir(REPO_ROOT) do
      sh("swiftlint lint --strict --quiet --config .swiftlint.yml")
      sh("swiftformat --lint .")
    end
    UI.success("static checks passed")
  end

  desc "The whole local quality gate"
  lane :qa do
    lint
    # No `run_core_tests` here: the `tests` lane below starts with it, and
    # running it twice cost this lane 150 seconds every time — measured, both
    # runs in the same log, 147.9 s and 149.2 s.
    build_app(
      project: PROJECT, scheme: SCHEME,
      destination: "generic/platform=iOS Simulator",
      skip_archive: true, skip_codesigning: true, skip_package_ipa: true,
      xcodebuild_formatter: "xcbeautify --quiet"
    )
    tests
    ui_tests
    UI.success("QA gate passed")
  end

  desc "Release-candidate gate — reports every sub-gate separately, never merged"
  lane :release_check do
    results = {}

    # Version and repository hygiene.
    version = get_version_number(xcodeproj: PROJECT, target: SCHEME)
    UI.message("MARKETING_VERSION: #{version}")
    results["Version is 1.0.0"] = (version == "1.0.0")
    results["Git tree clean"] = `git -C #{REPO_ROOT} status --porcelain`.strip.empty?

    # No secrets. A tracked key file is an immediate fail.
    #
    # Committed templates are explicitly not secrets: .env.example exists
    # precisely so nobody has to guess the variable names, and flagging it
    # would train people to ignore this check.
    tracked = `git -C #{REPO_ROOT} ls-files`.split("\n")
    leaked = tracked.select do |path|
      next false if path.end_with?(".example")

      basename = File.basename(path)
      path =~ /\.(p8|p12|mobileprovision|provisionprofile|cer|pem|keystore|jks)$/ ||
        basename.start_with?("AuthKey_") ||
        basename == ".env" ||
        basename.start_with?(".env.")
    end
    results["No secrets tracked"] = leaked.empty?
    UI.error("Tracked secret-like files: #{leaked.join(', ')}") unless leaked.empty?

    # App icon must be a real icon, not an empty slot.
    icon_dir = File.join(REPO_ROOT, "App/Keezly/Assets.xcassets/AppIcon.appiconset")
    results["App icon present"] = !Dir.glob(File.join(icon_dir, "*.png")).empty?

    # The shipped cues must still be the ones the generator makes. "Generated
    # from source" is a claim about provenance, and a claim nobody can check is
    # a story (§77).
    results["Sounds match their source"] = system("cd #{REPO_ROOT} && ./scripts/sounds-check.sh >/dev/null")

    # Screenshots. Reported as its own gate rather than folded into the others,
    # and absent is absent — a release check that passed with no screenshots at
    # all would be telling a useful lie.
    shots = File.join(ARTIFACTS, "screenshots")
    if Dir.exist?(shots) && !Dir.glob(File.join(shots, "**", "*.png")).empty?
      results["Screenshots verified"] = system("cd #{REPO_ROOT} && python3 scripts/screenshots-verify.py #{shots}")
    else
      results["Screenshots verified"] = false
      UI.error("No screenshot set at #{shots} — run the screenshots lane")
    end

    # Static checks. --strict turns SwiftLint warnings into failures, which is
    # the right bar for a release candidate even though it is not for a work
    # in progress.
    results["Static checks"] = system(
      "cd #{REPO_ROOT} && swiftlint lint --strict --quiet --config .swiftlint.yml && swiftformat --lint ."
    )

    # Simulator gate.
    begin
      run_core_tests
      results["Simulator gate"] = true
    rescue StandardError
      results["Simulator gate"] = false
    end

    UI.header("Keezly release gates")
    results.each { |name, ok| UI.message(format("%-24s : %s", name, ok ? "PASS" : "FAIL")) }

    # Device gates report BLOCKED rather than FAIL when no hardware exists,
    # because "not run" and "ran and failed" are different facts (§139, §178).
    %w[PRIMARY_IPHONE PRIMARY_IPAD].each do |role|
      label = role == "PRIMARY_IPHONE" ? "Physical iPhone gate" : "Physical iPad gate"
      UI.message(format("%-24s : %s", label, physical_destination(role) ? "AVAILABLE — run device_gate" : "BLOCKED"))
    end
    UI.message(format("%-24s : %s", "Game Center gate", "BLOCKED — see docs/GAME_CENTER_DEVICE_TESTS.md"))

    UI.user_error!("Release check failed") if results.value?(false)
    UI.important("Mandatory real-device gates are still BLOCKED — not releasable (§178).")
  end
end
